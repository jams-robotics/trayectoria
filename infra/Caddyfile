# Caddy configuration for self-hosting (docs/ops/SELF-HOSTING.md).
# SITE_ADDRESS: public domain of the site (automatic HTTPS), or ":80" for plain HTTP in local tests.
# API_ADDRESS: public domain of the Supabase API (automatic HTTPS), or ":8000" in local tests.
# SUPABASE_UPSTREAM: where the official Supabase compose exposes Kong (default host port 8000).

# Security headers of the site (#507): the same ones as apps/web/public/_headers, where each CSP
# source is explained, minus the Cloudflare Web Analytics origins. When the image is built,
# __SCRIPT_HASHES__ is replaced with the hashes of the inline scripts of the build
# (scripts/csp-hashes.mjs) and __SUPABASE_ORIGINS__ with the origins of PUBLIC_SUPABASE_URL
# (infra/csp-origins.sh).
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self' data:; connect-src 'self' __SUPABASE_ORIGINS__ blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
	}
}

{$SITE_ADDRESS} {
	import security_headers
	root * /srv
	encode zstd gzip
	try_files {path} {path}/ {path}.html
	file_server

	handle_errors 404 {
		import security_headers
		rewrite * /404.html
		file_server
	}
}

# Only the Supabase APIs are published (#510). Kong also serves the Studio and pg-meta (arbitrary
# SQL) behind basic auth only; they stay private and are reached through an SSH tunnel
# (docs/ops/SELF-HOSTING.md). GraphQL is not published either: the site does not use it (#527).
# Anything else gets 403.
{$API_ADDRESS} {
	@api path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/*
	handle @api {
		reverse_proxy {$SUPABASE_UPSTREAM:host.docker.internal:8000}
	}
	handle {
		respond 403
	}
}
