// Public instance on Cloudflare Workers with static assets (ARCHITECTURE.md §5.3, F7-05b).
// Deployed by .github/workflows/deploy.yml; step-by-step guide in docs/ops/DEPLOY.md.
{
  "name": "trayectoria",
  "compatibility_date": "2026-09-20",
  // Assets-only Worker: no script, Cloudflare serves the Astro static build directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // No routes: the custom domain is attached from the Cloudflare dashboard (DEPLOY.md, step 4.2).
  // The site is served only there; the trayectoria.<account>.workers.dev copy is off (#526).
  "workers_dev": false,
  // Pull requests upload a version (`wrangler versions upload`) that gets its own preview URL.
  "preview_urls": true,
}
