---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- Chasis con dos ruedas: la marca del mundo físico (DESIGN.md §1, §5). -->
<svg width="28" height="16" viewBox="0 0 28 16" fill="none" aria-hidden="true" class={className}>
  <rect x="3" y="2" width="22" height="12" rx="3" fill="var(--color-physical)"></rect>
  <rect x="0" y="4" width="4" height="8" rx="1" fill="var(--color-fg)"></rect>
  <rect x="24" y="4" width="4" height="8" rx="1" fill="var(--color-fg)"></rect>
</svg>
