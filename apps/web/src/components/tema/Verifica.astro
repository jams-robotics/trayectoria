---
import { t } from '@trayectoria/i18n';

import { exerciseKeys, findExercise } from '../../lib/exercises';
import { ProgressNotice } from '../progress/ProgressNotice';
import { ProgressSession } from '../progress/ProgressSession';
import Section from './Section.astro';
import { VerificaExercise } from './VerificaExercise';

// Section 6 (docs/CONTENT-STANDARDS.md §2): 3 to 5 exercises, one per `ExerciseWidget`, with
// the consecutive index and `required` according to `requiredExercises` of the frontmatter (#97, decision 2).
//
// The topic declares keys, not objects: `content/` lives outside `apps/web` (ADR-0005) and an MDX does
// not resolve the workspace packages, so resolution happens here. The island receives only the
// key (a serializable string): Astro serializes the props of a `client:visible` island to JSON, and
// the `generate`/`check` functions of `Exercise` do not survive that serialization (#97, high-severity
// audit finding of PR #119); the object is resolved in `VerificaExercise` from the same
// registry (`apps/web/src/lib/exercises.ts`).

interface Props {
  /** Keys of the topic's exercises, in increasing order of difficulty. */
  ejercicios: readonly string[];
  /** Topic id (`ruta-N/mNN-tNN`), which the widget reports to the progress adapter. */
  topicId: string;
  /** Ids of the mandatory exercises; `requiredExercises` of the frontmatter. */
  obligatorios?: readonly string[];
}

const { ejercicios, topicId, obligatorios = [] } = Astro.props;
const required = new Set(obligatorios);

// An unknown key stops the build naming the topic and the key, just like the references.
for (const key of ejercicios) {
  if (findExercise(key) === undefined) {
    throw new Error(
      `${topicId}: unknown exercise key "${key}" (components/tema/Verifica.astro); ` +
        `known keys: ${exerciseKeys().join(', ')}`,
    );
  }
}
---

<Section id="verifica" title={t('topic.sections.verifica')} number={6}>
  <ProgressSession client:load />
  <ProgressNotice client:load />
  <div class="grid gap-5">
    {ejercicios.map((key, position) => {
      const exercise = findExercise(key)!;
      return (
        <VerificaExercise
          client:visible
          exerciseKey={key}
          topicId={topicId}
          index={position + 1}
          required={required.has(exercise.id)}
          requiredExerciseIds={obligatorios}
        />
      );
    })}
  </div>
</Section>
