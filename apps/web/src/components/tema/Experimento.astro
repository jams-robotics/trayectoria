---
import { t } from '@trayectoria/i18n';

// Un experimento guiado de la sección «Explora», con la forma exacta del estándar:
// «cambia X → observa Y → ¿por qué?» y la respuesta desplegable (docs/CONTENT-STANDARDS.md §4).
interface Props {
  /** Qué mueve el estudiante. */
  cambia: string;
  /** Qué mira mientras lo mueve. */
  observa: string;
  /** La pregunta que cierra el experimento; la respuesta va en los hijos, máximo 3 frases. */
  porque: string;
}

const { cambia, observa, porque } = Astro.props;
---

<article class="bg-bg-raised border-border rounded-lg border p-5" data-testid="experiment">
  <p class="m-0 flex flex-wrap items-baseline gap-2">
    <span class="text-fg-muted text-sm">{t('topic.experiment.change')}</span>
    <span>{cambia}</span>
    <span class="text-fg-muted" aria-hidden="true">
      →
    </span>
    <span class="text-fg-muted text-sm">{t('topic.experiment.observe')}</span>
    <span>{observa}</span>
  </p>
  <p class="text-fg mt-2 mb-0">{porque}</p>
  <details class="mt-3">
    <summary class="text-primary min-h-11 flex cursor-pointer items-center text-sm font-medium">
      {t('topic.experiment.answer')}
    </summary>
    <div class="leading-body mt-2">
      <slot />
    </div>
  </details>
</article>
