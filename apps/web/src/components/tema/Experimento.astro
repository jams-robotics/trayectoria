---
import { t } from '@trayectoria/i18n';

// A guided experiment of the «Explora» section, with the exact shape of the standard:
// «cambia X → observa Y → ¿por qué?» and the collapsible answer (docs/CONTENT-STANDARDS.md §4).
interface Props {
  /** What the learner moves. */
  cambia: string;
  /** What they watch while moving it. */
  observa: string;
  /** The question that closes the experiment; the answer goes in the children, 3 sentences at most. */
  porque: string;
  /**
   * Values the «Aplicar» button sets in the topic widget, by the key of each slider of its
   * parameter panel (`{ kd: 0.8 }`). Without it the card has no button (v1.5).
   */
  aplica?: Record<string, number>;
}

const { cambia, observa, porque, aplica } = Astro.props;
---

<article
  class="bg-bg-raised border-border max-w-[72ch] rounded-lg border p-5"
  data-testid="experiment"
>
  <p class="m-0">
    <span class="text-fg-muted block text-sm">{t('topic.experiment.change')}</span>
    <span>{cambia}</span>
  </p>
  <p class="mt-3 mb-0">
    <span class="text-fg-muted block text-sm">{t('topic.experiment.observe')}</span>
    <span>{observa}</span>
  </p>
  {
    aplica !== undefined && (
      <button
        type="button"
        data-aplica={JSON.stringify(aplica)}
        class="border-primary text-primary hover:bg-primary hover:text-primary-fg mt-3 h-[44px] rounded-md border px-4 text-sm font-semibold transition-colors duration-[120ms]"
      >
        {t('widgets.Experimento.apply')}
      </button>
    )
  }
  <p class="text-fg border-border mt-4 mb-0 border-t pt-3 font-semibold">{porque}</p>
  <details class="mt-3">
    <summary class="text-primary min-h-[44px] flex cursor-pointer items-center text-sm font-medium">
      {t('topic.experiment.answer')}
    </summary>
    <div class="leading-body mt-2">
      <slot />
    </div>
  </details>
</article>

<script>
  // «Aplicar»: tells the parameter panel of the topic widget to take these values. The event name
  // is `APPLY_EVENT` of packages/widgets (ParamPanel).
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-aplica]')) {
    button.addEventListener('click', () => {
      const detail: unknown = JSON.parse(button.dataset.aplica ?? '{}');
      document.dispatchEvent(new CustomEvent('trayectoria:aplicar', { detail }));
    });
  }
</script>
