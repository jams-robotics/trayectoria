---
import { t } from '@trayectoria/i18n';

// A guided experiment of the «Explora» section, with the exact shape of the standard:
// «cambia X → observa Y → ¿por qué?» and the collapsible answer (docs/CONTENT-STANDARDS.md §4).
interface Props {
  /** What the learner moves. */
  cambia: string;
  /** What they watch while moving it. */
  observa: string;
  /** The question that closes the experiment; the answer goes in the children, 3 sentences at most. */
  porque: string;
}

const { cambia, observa, porque } = Astro.props;
---

<article
  class="bg-bg-raised border-border max-w-[72ch] rounded-lg border p-5"
  data-testid="experiment"
>
  <p class="m-0 flex flex-wrap items-baseline gap-2">
    <span class="text-fg-muted text-sm">{t('topic.experiment.change')}</span>
    <span>{cambia}</span>
    <span class="text-fg-muted" aria-hidden="true">
      →
    </span>
    <span class="text-fg-muted text-sm">{t('topic.experiment.observe')}</span>
    <span>{observa}</span>
  </p>
  <p class="text-fg mt-2 mb-0">{porque}</p>
  <details class="mt-3">
    <summary class="text-primary min-h-11 flex cursor-pointer items-center text-sm font-medium">
      {t('topic.experiment.answer')}
    </summary>
    <div class="leading-body mt-2">
      <slot />
    </div>
  </details>
</article>
