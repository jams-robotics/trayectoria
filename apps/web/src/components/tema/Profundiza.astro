---
import { t } from '@trayectoria/i18n';

import { resolveReferences } from '../../lib/references';

import Section from './Section.astro';

// Section 7 (docs/CONTENT-STANDARDS.md §2 and §6): 1 to 3 references. The topic only declares the
// keys; the text comes from `docs/REFERENCES.md` at build time (#97, decision 2). The children,
// optional, are the link to a later topic that uses this one.
interface Props {
  /** Keys of `docs/REFERENCES.md`, the same as in the frontmatter. */
  referencias: readonly string[];
  /** Topic id, to name it if a key does not exist. */
  topicId: string;
}

const { referencias, topicId } = Astro.props;
const references = resolveReferences(referencias, topicId);

/**
 * Splits the text of a reference into the spans the table's Markdown marks in italics
 * (`*título*`). It walks the spans instead of injecting HTML: `set:html` is forbidden on the
 * platform (docs/ops/I18N.md §1).
 */
const emphasised = (text: string): { text: string; italic: boolean }[] =>
  text.split(/\*([^*]+)\*/g).map((part, index) => ({ text: part, italic: index % 2 === 1 }));
---

<Section id="profundiza" title={t('topic.sections.profundiza')} number={7}>
  <ul class="m-0 grid list-none gap-3 p-0" aria-label={t('topic.references')}>
    {references.map(({ key, text }) => (
      <li class="flex gap-3" data-reference={key}>
        <span class="text-fg-muted font-mono text-xs">{key}</span>
        <span>
          {emphasised(text).map((part) =>
            part.italic ? <em>{part.text}</em> : <Fragment>{part.text}</Fragment>,
          )}
        </span>
      </li>
    ))}
  </ul>
  <slot />
</Section>
