---
import { t } from '@trayectoria/i18n';

// Outline of the 7 sections (#97, decision 5). On desktop it is the sticky 200 px side list
// of docs/DESIGN.md §5 (Navegación); at ≤ 390 px it becomes the collapsed `<details>` under the
// header of docs/design/07-tema-movil-claro.png.
interface Props {
  /** `true` paints the collapsible mobile variant; by default, the desktop side one. */
  mobile?: boolean;
}

const { mobile = false } = Astro.props;

// The keys are written as literals: the static i18n test only sees literals (ops/I18N.md).
const sections = [
  { id: 'gancho', title: t('topic.sections.gancho') },
  { id: 'concepto', title: t('topic.sections.concepto') },
  { id: 'formulas', title: t('topic.sections.formulas') },
  { id: 'explora', title: t('topic.sections.explora') },
  { id: 'al-robot', title: t('topic.sections.alRobot') },
  { id: 'verifica', title: t('topic.sections.verifica') },
  { id: 'profundiza', title: t('topic.sections.profundiza') },
];
---

{mobile ? (
  <details
    class="border-border rounded-lg bg-bg-raised mt-6 border md:hidden"
    data-outline="mobile"
  >
    <summary class="min-h-11 text-fg-muted flex cursor-pointer items-center gap-3 px-4 font-mono text-xs tracking-[0.06em] uppercase">
      <span class="flex-1">{t('topic.outline')}</span>
      <span class="outline-toggle-label whitespace-nowrap normal-case">
        {t('topic.outlineExpand')} ▾
      </span>
      <span class="outline-toggle-label outline-toggle-label--open whitespace-nowrap normal-case">
        {t('topic.outlineCollapse')} ▴
      </span>
    </summary>
    <nav aria-label={t('topic.outline')} class="px-4 pb-4">
      <ol class="border-border m-0 grid list-none gap-0 border-l-2 p-0">
        {sections.map(({ id, title }, index) => (
          <li>
            <a
              href={`#${id}`}
              data-outline-link={id}
              class="text-fg-muted hover:text-fg min-h-11 -ml-[2px] flex items-center gap-3 border-l-2 border-transparent pl-3 no-underline"
            >
              <span class="font-mono text-xs">{String(index + 1).padStart(2, '0')}</span>
              {title}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
) : (
  <nav
    aria-label={t('topic.outline')}
    data-outline="desktop"
    class="sticky top-6 hidden w-[200px] shrink-0 md:order-1 md:block"
  >
    <p class="text-fg-muted m-0 font-mono text-xs tracking-[0.06em] uppercase">
      {t('topic.outline')}
    </p>
    <ol class="border-border mt-3 grid list-none border-l-2 p-0">
      {sections.map(({ id, title }) => (
        <li>
          <a
            href={`#${id}`}
            data-outline-link={id}
            class="text-fg-muted hover:text-fg -ml-[2px] flex min-h-[40px] items-center border-l-2 border-transparent pl-3 text-sm no-underline"
          >
            {title}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  /* Current section of the outline: border and text in `primary` (docs/DESIGN.md §5, Navegación). */
  a[data-outline-link][aria-current='true'] {
    border-left-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  /* «ver ▾ / ocultar ▴» toggle of the mobile summary (#529): resolved with `details[open]` in
     CSS alone, same pair as SimAccordion.tsx, no JavaScript added. */
  details[data-outline='mobile'] > summary .outline-toggle-label--open {
    display: none;
  }
  details[data-outline='mobile'][open] > summary .outline-toggle-label {
    display: none;
  }
  details[data-outline='mobile'][open] > summary .outline-toggle-label--open {
    display: inline;
  }
</style>

<script>
  // Marks the visible section in the outline. `window` is allowed in apps/web (CLAUDE.md).
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-outline-link]')];
  if (sections.length > 0 && links.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const mark = (): void => {
      const current = sections.find((section) => visible.has(section.dataset.section ?? ''));
      for (const link of links) {
        const active =
          current !== undefined && link.dataset.outlineLink === current.dataset.section;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).dataset.section ?? '';
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }
        mark();
      },
      { rootMargin: '-72px 0px -60% 0px' },
    );
    for (const section of sections) observer.observe(section);
  }
</script>
