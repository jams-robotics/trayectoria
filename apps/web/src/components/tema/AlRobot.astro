---
import { t } from '@trayectoria/i18n';

import Section from './Section.astro';

// Section 5 (docs/CONTENT-STANDARDS.md §2): the concept with the data of «Mi robot».
---

<Section id="al-robot" title={t('topic.sections.alRobot')} number={4} accent="physical" wide>
  <slot />
</Section>

<style>
  /*
    The section is `wide` only so the calc cards can grow: text and «Mi robot» keep 72ch. A card is
    72ch at least and grows to the content column when its formula does not fit, so it scrolls
    only past that (v1.5).
  */
  :global(#al-robot .prose > :not(astro-island, [data-robot-formula])),
  :global(#al-robot .prose > astro-island > div:not([data-block='true'])) {
    max-width: 72ch;
  }
  :global(#al-robot div[data-robot-formula]),
  :global(#al-robot .prose > astro-island > div[data-block='true']) {
    width: fit-content;
    min-width: min(100%, 72ch);
    max-width: 100%;
  }
  /* The «Al robot» calc cards sit in the section's prose: separate them from text and from each other. */
  :global(#al-robot div[data-robot-formula]) {
    margin-top: var(--space-5);
  }
  /* The orange marks what happens to the learner's robot: the calc card carries it on its edge. */
  :global(#al-robot div[data-robot-formula] > astro-island > div) {
    border-left: 4px solid var(--color-physical);
  }
</style>
