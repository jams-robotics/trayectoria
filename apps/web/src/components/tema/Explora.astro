---
import { t } from '@trayectoria/i18n';

import Section from './Section.astro';

// Sección 4 (docs/CONTENT-STANDARDS.md §2): el widget grande y de 2 a 4 `Experimento`, que el
// MDX pasa como hijos de esta sección (#97, decisión 2). Es la única sección `wide`: el widget
// ocupa toda la columna de contenido y el texto y los experimentos se quedan en 72ch (#302).
---

<Section id="explora" title={t('topic.sections.explora')} number={4} wide>
  <div class="grid gap-5">
    <slot />
  </div>
</Section>
