---
import { TopicWidget } from './TopicWidget';

// A formula block inside `Formulas` (docs/DESIGN.md §5, Bloque de fórmula). It goes in the
// MDX component map instead of being imported from the topic: `content/` lives outside
// `apps/web` (ADR-0005) and does not resolve the workspace packages.
//
// The widget is resolved by name with the dynamic `import()` of its own entry
// (`@trayectoria/widgets/Formula`, ADR-0009 and #188) instead of a static import from the barrel:
// that way the topic page does not download KaTeX until the island mounts.
//
// The island is `client:only` because the widget arrives through `import()`: with `client:visible`
// the server would paint the empty `fallback` of the `Suspense` and the client the already resolved
// widget, and that difference breaks React hydration.
interface Props {
  latex: string;
  /** Variable to highlight in the formula. */
  highlight?: string;
  /** The same formula with the numbers already substituted, under a divider. */
  substituted?: string;
}

const { latex, highlight, substituted } = Astro.props;
const props = {
  block: true,
  latex,
  ...(highlight === undefined ? {} : { highlight }),
  ...(substituted === undefined ? {} : { substituted }),
};
---

<TopicWidget client:only="react" name="Formula" props={props} />
