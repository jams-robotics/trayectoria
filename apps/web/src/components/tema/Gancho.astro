---
import Section from './Section.astro';

// Opening challenge (docs/CONTENT-STANDARDS.md §2): the robotics question with numbers of the topic.
// It has no heading and no number: the topic opens with the question itself (v1.5).
---

<Section id="gancho">
  <div class="gancho border-physical border-l-4 pl-4 text-lg leading-body">
    <slot />
  </div>
</Section>

<style>
  /* The box already sits at the section's top: the first paragraph needs no prose margin. */
  div.gancho :global(p:first-child) {
    margin-top: 0;
  }
</style>
