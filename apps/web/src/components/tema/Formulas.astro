---
import { t } from '@trayectoria/i18n';

import Section from './Section.astro';

// Section 3 (docs/CONTENT-STANDARDS.md §2): each formula in its `Formula` block followed by the
// list of variables (symbol, name, SI unit), which the MDX passes as children.
---

<Section id="formulas" title={t('topic.sections.formulas')} number={3}>
  <div class="grid gap-6">
    <slot />
  </div>
</Section>
