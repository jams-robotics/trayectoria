---
import { t } from '@trayectoria/i18n';

import { COFFEE_URL, CONTACT_EMAIL, mailtoHref, reportIssueUrl } from '../lib/contact';

const links = [
  { href: 'https://github.com/jams-robotics/trayectoria', label: t('footer.repository') },
  { href: '/contribuir', label: t('footer.contribute') },
  { href: '/acerca', label: t('footer.about') },
  { href: mailtoHref(CONTACT_EMAIL, t('footer.contact')), label: t('footer.contact') },
  {
    href: reportIssueUrl({ title: '[Sitio] ', label: 'bug', tema: 'sitio' }),
    label: t('footer.reportError'),
  },
] as const;

// The coffee link is hidden whenever COFFEE_URL is empty (#591, #605).
const coffeeLink =
  COFFEE_URL === '' ? undefined : { href: COFFEE_URL, label: t('footer.coffee') };
---

<footer class="border-border border-t">
  <div class="text-fg-muted mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-3 px-5 py-6 text-sm md:px-8">
    <p class="m-0">{t('footer.license')}</p>
    <ul class="m-0 flex list-none gap-5 p-0">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="no-underline hover:underline">
            {label}
          </a>
        </li>
      ))}
      {coffeeLink !== undefined && (
        <li>
          <a href={coffeeLink.href} rel="noopener" class="no-underline hover:underline">
            {coffeeLink.label}
          </a>
        </li>
      )}
    </ul>
  </div>
</footer>
