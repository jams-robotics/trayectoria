---
import { t } from '@trayectoria/i18n';

import { WidgetsPlayground } from '../../components/dev/WidgetsPlayground';
import Base from '../../layouts/Base.astro';

// F2-01a playground: one section per widget with its stories, rendered by the StoryGallery
// island of @trayectoria/widgets. Not linked from Nav.astro; it exists for manual review and
// for the visual regression snapshots of e2e/visual.
//
// `?section=<Nombre>` narrows the page to that widget's section, so a snapshot of e2e/visual is
// taken over a page that only holds its own widget and does not move when a story is added to
// another one (#108, decision 2). This page is prerendered, so `Astro.url.searchParams` cannot
// see a query string added at request time (QA #108, PR #140: the island hydrated with
// `section: null` in `astro dev`, and every section rendered regardless of the query string).
// `WidgetsPlayground` reads it on the client instead, with `client:only` so there is no SSR pass
// to mismatch against.
---

<Base title={t('widgets.playground.title')}>
  <section class="mx-auto max-w-[1120px] px-5 pt-11 pb-9 md:px-8">
    <h1 class="text-2xl leading-tight max-w-[72ch] font-semibold">
      {t('widgets.playground.title')}
    </h1>
    <p class="text-fg-muted mt-4 max-w-[72ch]">{t('widgets.playground.lead')}</p>
    <WidgetsPlayground client:only="react" />
  </section>
</Base>
