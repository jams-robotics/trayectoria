---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { t } from '@trayectoria/i18n';

import { temaComponents } from '../../../../components/tema';
import Tema from '../../../../layouts/Tema.astro';
import { resolvePrerequisites, routeTopics } from '../../../../lib/routes';

export const getStaticPaths = (async () => {
  // Only a published topic has a page (docs/ARCHITECTURE.md §3.2, «Filtro por status»), and the
  // filter goes before the directory checks.
  const topics = (await getCollection('topics')).filter(
    (topic) => topic.data.status === 'published',
  );
  return topics.map((topic) => {
    const [ruta, slug] = topic.id.split('/');
    const [modulo, tema] = slug?.split('-') ?? [];
    const file = `content/es/${topic.id}/index.mdx`;
    if (ruta === undefined || modulo === undefined || tema === undefined) {
      throw new Error(`${file}: directory must have the form ruta-N/mNN-tNN`);
    }
    if (topic.data.id !== topic.id) {
      throw new Error(
        `${file}: frontmatter id "${topic.data.id}" must match the directory "${topic.id}"`,
      );
    }
    if (
      topic.data.module !== Number(modulo.slice(1)) ||
      topic.data.order !== Number(tema.slice(1))
    ) {
      throw new Error(
        `${file}: frontmatter module ${topic.data.module} and order ${topic.data.order} must match the directory ${modulo}-${tema}`,
      );
    }
    return { params: { ruta, modulo, tema }, props: { topic } };
  });
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
const { ruta } = Astro.params;
const route = await getEntry('routes', ruta);
if (route === undefined) {
  throw new Error(`content/es/${ruta}/ruta.json is missing for topic ${topic.id}`);
}

const published = new Set(
  (await getCollection('topics'))
    .filter((entry) => entry.data.status === 'published')
    .map((entry) => entry.id),
);
const routes = (await getCollection('routes')).map((entry) => ({ ...entry.data, id: entry.id }));

// Flat topic order of this route, from ruta.json. Neighbours that are not published are shown
// without a link, like in the route index; previous and next stay inside the route (§3.2).
const ordered = routeTopics({ ...route.data, id: route.id }, published);
const position = ordered.findIndex((entry) => entry.id === topic.id);
if (position === -1) {
  throw new Error(`content/es/${ruta}/ruta.json does not list topic ${topic.id}`);
}

// Prerequisites resolved against every route; the build fails on one that is in no route, comes
// after the topic or is in a route this one does not follow (§3.2, «Prerrequisitos entre rutas»).
const prerequisites = resolvePrerequisites(topic.id, topic.data.prerequisites, routes, published);

const { Content } = await render(topic);
const { title, seoTitle, seoDescription, estimatedMinutes, module, order } = topic.data;
// Real progress arrives with F3-01; until then every topic of the route counts as pending.
const DONE_TOPICS = 0;
---

<Tema
  title={title}
  topicId={topic.id}
  seoTitle={seoTitle}
  description={seoDescription}
  route={{ title: route.data.title, href: `/ruta/${route.id}` }}
  eyebrow={t('topic.number', { module, order })}
  estimatedMinutes={estimatedMinutes}
  prerequisites={prerequisites.sameRoute}
  prerequisitesFromRoutes={prerequisites.otherRoutes}
  done={DONE_TOPICS}
  total={ordered.length}
  previous={ordered[position - 1]}
  next={ordered[position + 1]}
>
  <Content components={temaComponents} />
</Tema>
