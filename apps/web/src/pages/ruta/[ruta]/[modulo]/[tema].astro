---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { t } from '@trayectoria/i18n';

import Base from '../../../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const topics = await getCollection('topics');
  return topics.map((topic) => {
    const [ruta, slug] = topic.id.split('/');
    const [modulo, tema] = slug?.split('-') ?? [];
    const file = `content/es/${topic.id}/index.mdx`;
    if (ruta === undefined || modulo === undefined || tema === undefined) {
      throw new Error(`${file}: directory must have the form ruta-N/mNN-tNN`);
    }
    if (topic.data.id !== topic.id) {
      throw new Error(
        `${file}: frontmatter id "${topic.data.id}" must match the directory "${topic.id}"`,
      );
    }
    if (
      topic.data.module !== Number(modulo.slice(1)) ||
      topic.data.order !== Number(tema.slice(1))
    ) {
      throw new Error(
        `${file}: frontmatter module ${topic.data.module} and order ${topic.data.order} must match the directory ${modulo}-${tema}`,
      );
    }
    return { params: { ruta, modulo, tema }, props: { topic } };
  });
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
const { ruta } = Astro.params;
const route = await getEntry('routes', ruta);
if (route === undefined) {
  throw new Error(`content/es/${ruta}/ruta.json is missing for topic ${topic.id}`);
}

const published = new Set((await getCollection('topics')).map((entry) => entry.id));

// Flat topic order across modules, from ruta.json. Neighbours that do not exist yet are shown
// without a link, like in the route index.
const ordered = route.data.modules.flatMap((module) =>
  module.topics.map((entry) => {
    const id = `${route.id}/${entry.id}`;
    return {
      id,
      title: entry.title,
      href: published.has(id)
        ? `/ruta/${route.id}/${module.id}/${entry.id.slice(module.id.length + 1)}`
        : undefined,
    };
  }),
);
const position = ordered.findIndex((entry) => entry.id === topic.id);
if (position === -1) {
  throw new Error(`content/es/${ruta}/ruta.json does not list topic ${topic.id}`);
}
const previous = ordered[position - 1];
const next = ordered[position + 1];

const { Content } = await render(topic);
const { title, estimatedMinutes, prerequisites } = topic.data;
---

<Base title={title}>
  <article class="mx-auto max-w-[1200px] px-5 py-9 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      <a href={`/ruta/${route.id}`} class="no-underline hover:underline">
        {route.data.title}
      </a>
      {` · ${t('topic.number', { module: topic.data.module, order: topic.data.order })}`}
    </p>
    <h1 class="text-2xl leading-tight mt-3 max-w-[72ch] font-semibold">{title}</h1>
    <dl class="text-fg-muted mt-4 flex flex-wrap gap-6 text-sm">
      <div class="flex gap-2">
        <dt>{t('topic.estimatedTime')}</dt>
        <dd class="m-0 font-mono">{t('topic.minutes', { minutes: estimatedMinutes })}</dd>
      </div>
      <div class="flex gap-2">
        <dt>{t('topic.prerequisites')}</dt>
        <dd class="m-0 font-mono">
          {prerequisites.length === 0 ? t('topic.noPrerequisites') : prerequisites.join(', ')}
        </dd>
      </div>
    </dl>

    <div class="prose-topic leading-body mt-8 max-w-[72ch]">
      <Content />
    </div>

    <nav aria-label={t('topic.pagination')} class="border-border mt-10 border-t pt-6">
      <ul class="m-0 flex list-none justify-between gap-5 p-0">
        {previous !== undefined && (
          <li>
            <span class="text-fg-muted block text-sm">{t('topic.previous')}</span>
            {previous.href !== undefined ? (
              <a href={previous.href} rel="prev">
                {previous.title}
              </a>
            ) : (
              <span class="text-fg-muted">{previous.title}</span>
            )}
          </li>
        )}
        {next !== undefined && (
          <li class="ml-auto text-right">
            <span class="text-fg-muted block text-sm">{t('topic.next')}</span>
            {next.href !== undefined ? (
              <a href={next.href} rel="next">
                {next.title}
              </a>
            ) : (
              <span class="text-fg-muted">{next.title}</span>
            )}
          </li>
        )}
      </ul>
    </nav>
  </article>
</Base>

<style>
  /* Minimal reading styles until F2-13 delivers the section components. */
  .prose-topic :global(h2) {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
    margin-top: var(--space-9);
  }
  .prose-topic :global(p) {
    margin-top: var(--space-4);
  }
</style>
