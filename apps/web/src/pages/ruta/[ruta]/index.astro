---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { t } from '@trayectoria/i18n';

import { ProgressSession } from '../../../components/progress/ProgressSession';
import {
  RouteCompleted,
  RouteProgress,
  TopicStatus,
} from '../../../components/progress/RouteProgress';
import Base from '../../../layouts/Base.astro';
import { followerOf, routeTopics, topicUrl } from '../../../lib/routes';

export const getStaticPaths = (async () => {
  const routes = await getCollection('routes');
  return routes.map((route) => ({ params: { ruta: route.id }, props: { route } }));
}) satisfies GetStaticPaths;

const { route } = Astro.props;
const topics = await getCollection('topics');
// Only a published topic is linked (§3.2, «Filtro por status»); the rest are listed without one.
const publishedIds = new Set(
  topics.filter((topic) => topic.data.status === 'published').map((topic) => topic.id),
);
const routes = (await getCollection('routes')).map((entry) => ({ ...entry.data, id: entry.id }));

// The route schema validates data.id as ruta-N; route.id (from the directory) is only for URLs.
const routeNumber = route.data.id.slice('ruta-'.length);
const ordered = routeTopics({ ...route.data, id: route.id }, publishedIds);
const topicCount = ordered.length;
// Ids of every topic of the route, in the order of ruta.json: what RouteProgress counts, what
// RouteCompleted checks (ARCHITECTURE §3.2) and what each TopicStatus island reads from
// `$progress` (#120, decision 4).
const topicIds = ordered.map((topic) => topic.id);

// Link to the other route under the header (§3.2): the route that continues this one, or the
// one this route follows.
const follower = followerOf(route.id, routes);
const followed = routes.find((entry) => entry.id === route.data.follows);
const continueLink =
  follower === undefined
    ? undefined
    : {
        href: `/ruta/${follower.id}`,
        label: t('route.continue', { title: follower.shortTitle }),
      };
const usesLink =
  followed === undefined
    ? undefined
    : { href: `/ruta/${followed.id}`, label: t('route.uses', { title: followed.shortTitle }) };
---

<Base title={route.data.title}>
  <section class="mx-auto max-w-[1120px] px-5 py-9 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('route.eyebrow', { number: routeNumber })}
    </p>
    <h1 class="text-2xl leading-tight mt-3 max-w-[72ch] font-semibold">{route.data.title}</h1>
    <p class="text-fg-muted mt-3">
      <span class="font-mono">{route.data.modules.length}</span>
      {` ${t('route.modules')} · `}
      <span class="font-mono">{topicCount}</span>
      {` ${t('route.topics')}`}
    </p>
    {continueLink !== undefined && (
      <p class="mt-3" data-testid="route-continue">
        <a href={continueLink.href}>{continueLink.label}</a>
      </p>
    )}
    {usesLink !== undefined && (
      <p class="mt-3" data-testid="route-uses">
        <a href={usesLink.href}>{usesLink.label}</a>
      </p>
    )}
    <RouteCompleted client:load topicIds={topicIds} continueLink={continueLink} />

    <ProgressSession client:load />
    <RouteProgress client:load topicIds={topicIds} />

    <ol class="mt-8 grid list-none gap-5 p-0">
      {route.data.modules.map((module) => (
        <li class="bg-bg-raised border-border rounded-lg border p-6">
          <h2 class="text-lg leading-tight m-0 flex items-baseline gap-3 font-semibold">
            <span class="text-fg-muted font-mono text-xs font-normal">
              {t('route.moduleNumber', { number: module.number })}
            </span>
            {module.title}
          </h2>
          <ol class="mt-4 grid list-none gap-2 p-0">
            {module.topics.map((topic, index) => (
              <li class="flex items-center gap-3">
                <span class="text-fg-muted font-mono text-xs">
                  {module.number}.{index + 1}
                </span>
                {publishedIds.has(`${route.id}/${topic.id}`) ? (
                  <a href={topicUrl(`${route.id}/${topic.id}`)}>{topic.title}</a>
                ) : (
                  <span class="text-fg-muted">{topic.title}</span>
                )}
                <TopicStatus client:load topicId={`${route.id}/${topic.id}`} />
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>
</Base>
