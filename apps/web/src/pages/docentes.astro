---
import { t } from '@trayectoria/i18n';

import Base from '../layouts/Base.astro';

// Public page for teachers (F7-05): classroom use, modo aula and the robot catalog.
const classroomSteps = [
  t('teachersPage.classroom.steps.topic'),
  t('teachersPage.classroom.steps.explore'),
  t('teachersPage.classroom.steps.exercises'),
  t('teachersPage.classroom.steps.robot'),
] as const;

const aulaSteps = [
  t('teachersPage.aula.steps.create'),
  t('teachersPage.aula.steps.join'),
  t('teachersPage.aula.steps.follow'),
  t('teachersPage.aula.steps.export'),
] as const;

const secondaryLink =
  'bg-bg-raised text-fg border-border hover:border-fg-muted rounded-md inline-flex min-h-[44px] items-center border px-5 font-semibold no-underline';
---

<Base title={t('teachersPage.title')} description={t('teachersPage.description')}>
  <article class="mx-auto max-w-[1120px] px-5 pt-11 pb-12 md:px-8">
    <header class="mx-auto max-w-[72ch]">
      <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
        {t('teachersPage.eyebrow')}
      </p>
      <h1 class="text-xl md:text-2xl leading-tight mt-4 font-semibold">
        {t('teachersPage.title')}
      </h1>
      <p class="text-fg-muted text-lg leading-body mt-6">{t('teachersPage.lead')}</p>
    </header>

    <section class="mt-11 mx-auto max-w-[72ch]" aria-labelledby="clase-titulo">
      <h2 id="clase-titulo" class="text-lg leading-tight font-semibold">
        {t('teachersPage.classroom.title')}
      </h2>
      <ol class="leading-body mt-4 list-decimal space-y-3 pl-6">
        {classroomSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="mt-6">
        <a href="/ruta/ruta-1" class={secondaryLink}>
          {t('teachersPage.classroom.route')}
        </a>
      </p>
    </section>

    <section class="mt-11 mx-auto max-w-[72ch]" aria-labelledby="aula-titulo">
      <h2 id="aula-titulo" class="text-lg leading-tight font-semibold">
        {t('teachersPage.aula.title')}
      </h2>
      <p class="text-fg-muted leading-body mt-4">{t('teachersPage.aula.text')}</p>
      <ol class="leading-body mt-4 list-decimal space-y-3 pl-6">
        {aulaSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p class="text-fg-muted leading-body mt-4">{t('teachersPage.aula.notLms')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/aula"
          class="bg-primary text-primary-fg border-primary hover:bg-primary-hover rounded-md inline-flex min-h-[44px] items-center border px-5 font-semibold no-underline"
        >
          {t('teachersPage.aula.open')}
        </a>
        <a href="/unirse" class={secondaryLink}>
          {t('teachersPage.aula.join')}
        </a>
      </div>
    </section>

    <section class="mt-11 mx-auto max-w-[72ch]" aria-labelledby="catalogo-titulo">
      <h2 id="catalogo-titulo" class="text-lg leading-tight font-semibold">
        {t('teachersPage.catalog.title')}
      </h2>
      <p class="leading-body mt-4">{t('teachersPage.catalog.arms')}</p>
      <p class="leading-body mt-4">{t('teachersPage.catalog.mobile')}</p>
      <p class="mt-6">
        <a href="/brazos" class={secondaryLink}>
          {t('teachersPage.catalog.cta')}
        </a>
      </p>
    </section>
  </article>
</Base>
