---
import { t } from '@trayectoria/i18n';

import { MobileSimIsland } from '../../components/sim/MobileSimIsland';
import Base from '../../layouts/Base.astro';

// F4-02b (#128): the 2D mobile simulator page (docs/ARCHITECTURE.md §3.2).
//
// The island is `client:visible` (#128, decision 1): the 2D simulator does not need `three`, so
// nothing of this page enters the 3D scenes chunk and the JS budget of
// docs/ARCHITECTURE.md §8 is met with the viewer, the track editor and the widget.
---

<Base title={t('sims.mobilePage.title')} description={t('sims.mobilePage.lead')}>
  <section class="mx-auto max-w-[1120px] px-5 pt-11 pb-9 md:px-8">
    <h1 class="text-xl leading-tight md:text-2xl font-semibold">{t('sims.mobilePage.title')}</h1>
    <p class="text-fg-muted mt-4 max-w-[72ch]">{t('sims.mobilePage.lead')}</p>
    <MobileSimIsland client:visible />
  </section>
</Base>
