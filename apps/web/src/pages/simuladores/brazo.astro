---
import { getCollection } from 'astro:content';
import { t } from '@trayectoria/i18n';

import { ArmSimIsland } from '../../components/sim/ArmSimIsland';
import Base from '../../layouts/Base.astro';

// F5-01b (#134): the 3D arm simulator page (docs/ARCHITECTURE.md §3.2).
//
// The arms come from the `arms` collection at build time and are passed to the island as
// serializable props, `{ id, name }[]` (#134, decision 2): the island neither reads the catalogue nor
// imports sim-core. `?robot=<id>` is read by the island on the client, because the page is static and
// `Astro.url.searchParams` does not see a query string added after the build.
//
// The island is `client:only="react"`: that way there is no SSR pass to mismatch and `three` and
// `urdf-loader` only enter this page's chunk (docs/ARCHITECTURE.md §3.1 and §8).
//
// F7-02b (#444): until the island hydrates, an empty fallback reserves its height (≥ 758 px
// once loaded), so the page does not grow and shift sideways when it appears.

const collection = await getCollection('arms');
const arms = collection.map((arm) => ({ id: arm.id, name: arm.data.name }));
---

<Base title={t('sims.armPage.title')} description={t('sims.armPage.lead')}>
  <section class="mx-auto max-w-[1120px] px-5 pt-11 pb-9 md:px-8">
    <h1 class="text-xl leading-tight md:text-2xl font-semibold">{t('sims.armPage.title')}</h1>
    <p class="text-fg-muted mt-4 max-w-[72ch]">{t('sims.armPage.lead')}</p>
    <ArmSimIsland arms={arms} client:only="react">
      <div slot="fallback" class="mt-6 min-h-[740px]" aria-hidden="true"></div>
    </ArmSimIsland>
  </section>
</Base>
