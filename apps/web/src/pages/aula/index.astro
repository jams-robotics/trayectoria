---
import { getEntry } from 'astro:content';
import { t } from '@trayectoria/i18n';

import { AulaIsland } from '../../components/aula/AulaIsland';
import Base from '../../layouts/Base.astro';
import type { MatrixTopic } from '../../lib/aula/progressMatrix';

// One island with client:load, like /cuenta (docs/ARCHITECTURE.md §3.1). The CTA texts are
// resolved here because packages/auth only imports db (§2). The group detail lives on this same
// page as `/aula?grupo=<uuid>`: `output: 'static'` cannot prerender `/aula/[groupId]`.
const cta = {
  title: t('auth.gate.title'),
  body: t('auth.gate.body'),
  register: t('auth.gate.register'),
  login: t('auth.gate.login'),
};

// Topics of ruta-1 in the order of `content/es/ruta-1/ruta.json`, read at build time through the
// `routes` collection, as the route index does. They travel to the island as plain props, which
// is what the classroom table paints as rows (F3-02b). One route for now.
const route = await getEntry('routes', 'ruta-1');
const topics: MatrixTopic[] = (route?.data.modules ?? []).flatMap((module) =>
  module.topics.map((topic) => ({
    id: `ruta-1/${topic.id}`,
    moduleId: module.id,
    moduleTitle: module.title,
    title: topic.title,
  })),
);
---

<Base title={t('aula.title')}>
  <section class="mx-auto max-w-[1120px] px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">{t('aula.eyebrow')}</p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('aula.title')}</h1>
    <div class="mt-7">
      <AulaIsland client:load cta={cta} topics={topics} />
    </div>
  </section>
</Base>
