---
import { getCollection } from 'astro:content';
import { t } from '@trayectoria/i18n';

import { AulaIsland } from '../../components/aula/AulaIsland';
import Base from '../../layouts/Base.astro';
import { matrixRoutes } from '../../lib/aula/progressMatrix';

// One island with client:load, like /cuenta (docs/ARCHITECTURE.md §3.1). The CTA texts are
// resolved here because packages/auth only imports db (§2). The group detail lives on this same
// page as `/aula?grupo=<uuid>`: `output: 'static'` cannot prerender `/aula/[groupId]`.
const cta = {
  title: t('auth.gate.title'),
  body: t('auth.gate.body'),
  register: t('auth.gate.register'),
  login: t('auth.gate.login'),
};

// Topics of both routes, in route order and in the order of each `ruta.json`, read at build time
// through the `routes` collection, as the route index does. They travel to the island as plain
// props; the classroom table paints the route chosen in its selector (F3-02b, #574, §3.2).
const routes = matrixRoutes(
  (await getCollection('routes')).map((entry) => ({ ...entry.data, id: entry.id })),
);
---

<Base title={t('aula.title')}>
  <section class="mx-auto flex w-full max-w-[1120px] flex-1 flex-col px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">{t('aula.eyebrow')}</p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('aula.title')}</h1>
    <!-- #538: the sign-up card is centred in the height the page leaves under the title. -->
    <div class="mt-7 flex flex-1 flex-col has-[[data-auth=anonymous]]:justify-center">
      <AulaIsland client:load cta={cta} routes={routes} />
    </div>
  </section>
</Base>
