---
import { t } from '@trayectoria/i18n';

import { JoinGroupForm } from '../components/aula/JoinGroupForm';
import Base from '../layouts/Base.astro';

// One island with client:load, like /cuenta and /aula (docs/ARCHITECTURE.md §3.1). The CTA texts
// are resolved here because packages/auth only imports db (§2). `?codigo=XXXXXXXX` prefills the
// field; the island reads it from the query string, so the page stays prerendered.
const cta = {
  title: t('auth.gate.title'),
  body: t('auth.gate.body'),
  register: t('auth.gate.register'),
  login: t('auth.gate.login'),
};
---

<Base title={t('aula.join.title')}>
  <section class="mx-auto max-w-[1120px] px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('aula.join.eyebrow')}
    </p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('aula.join.title')}</h1>
    <div class="mt-7 max-w-[640px]">
      <JoinGroupForm client:load cta={cta} />
    </div>
  </section>
</Base>
