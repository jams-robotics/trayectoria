---
import { t } from '@trayectoria/i18n';

import { Account } from '../../components/auth/Account';
import { MyRobotIsland } from '../../components/robot/MyRobotIsland';
import Base from '../../layouts/Base.astro';

// Account wraps AuthGate, the one island with client:load (docs/ARCHITECTURE.md §3.1). The CTA
// texts are resolved here because packages/auth only imports db (§2).
const cta = {
  title: t('auth.gate.title'),
  body: t('auth.gate.body'),
  register: t('auth.gate.register'),
  login: t('auth.gate.login'),
};
---

<Base title={t('auth.account.title')}>
  <section class="mx-auto max-w-[1120px] px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('auth.account.eyebrow')}
    </p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('auth.account.title')}</h1>
    <div class="mt-7 max-w-[640px]">
      <Account client:load cta={cta} />
    </div>
    <!-- «Mi robot» (F2-11): its own island so it can attach the Supabase adapter to the store
      and render only with a session, without touching the Account island. -->
    <div class="mt-7 max-w-[640px]">
      <MyRobotIsland client:load />
    </div>
  </section>
</Base>
