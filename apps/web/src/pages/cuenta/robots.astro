---
import { t } from '@trayectoria/i18n';

import { RobotsIsland } from '../../components/robots/RobotsIsland';
import Base from '../../layouts/Base.astro';

// Same layout and session guard as /cuenta (F3-04): one island with client:load wrapping
// AuthGate (docs/ARCHITECTURE.md §3.1). The CTA texts are resolved here because packages/auth
// only imports db (§2).
const cta = {
  title: t('auth.gate.title'),
  body: t('auth.gate.body'),
  register: t('auth.gate.register'),
  login: t('auth.gate.login'),
};
---

<Base title={t('auth.robots.title')}>
  <section class="mx-auto max-w-[1120px] px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('auth.robots.eyebrow')}
    </p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('auth.robots.title')}</h1>
    <p class="text-fg-muted mt-4 max-w-[640px]">{t('auth.robots.intro')}</p>
    <div class="mt-7">
      <RobotsIsland client:load cta={cta} />
    </div>
  </section>
</Base>
