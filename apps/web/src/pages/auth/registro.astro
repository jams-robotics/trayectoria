---
import { t } from '@trayectoria/i18n';

import { RegisterForm } from '../../components/auth/RegisterForm';
import Base from '../../layouts/Base.astro';
---

<Base title={t('auth.register.title')}>
  <section class="mx-auto max-w-site px-5 py-11 md:px-8">
    <h1 class="text-2xl leading-tight font-semibold">{t('auth.register.title')}</h1>
    <div class="mt-7 max-w-[480px]">
      <RegisterForm client:visible />
    </div>
  </section>
</Base>
