---
import { t } from '@trayectoria/i18n';

import { LoginForm } from '../../components/auth/LoginForm';
import Base from '../../layouts/Base.astro';
---

<Base title={t('auth.login.title')}>
  <section class="mx-auto max-w-[1120px] px-5 py-11 md:px-8">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('auth.login.eyebrow')}
    </p>
    <h1 class="text-2xl leading-tight mt-4 font-semibold">{t('auth.login.title')}</h1>
    <div class="mt-7 max-w-[480px]">
      <LoginForm client:visible />
    </div>
  </section>
</Base>
