---
import { t } from '@trayectoria/i18n';

import ChassisIcon from '../components/ChassisIcon.astro';
import Base from '../layouts/Base.astro';

// Route 1 as specified in docs/PLAN.md §2 (7 modules, 27 topics).
const modules = [
  { name: t('home.modules.tools'), topics: 3 },
  { name: t('home.modules.particleKinematics'), topics: 4 },
  { name: t('home.modules.dynamics'), topics: 3 },
  { name: t('home.modules.energy'), topics: 2 },
  { name: t('home.modules.rotation'), topics: 5 },
  { name: t('home.modules.differentialRobot'), topics: 5 },
  { name: t('home.modules.lineFollower'), topics: 5 },
] as const;

const features = [
  {
    icon: 'circle',
    title: t('home.features.widgets.title'),
    text: t('home.features.widgets.text'),
  },
  {
    icon: 'chassis',
    title: t('home.features.simulators.title'),
    text: t('home.features.simulators.text'),
  },
  {
    icon: 'square',
    title: t('home.features.myRobot.title'),
    text: t('home.features.myRobot.text'),
  },
] as const;
---

<Base title={t('home.title')}>
  <section class="mx-auto max-w-[1120px] px-5 pt-11 pb-9 md:px-8">
    <div class="grid items-start gap-9 lg:grid-cols-[1fr_500px] lg:gap-10">
      <div>
        <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
          {t('home.eyebrow')}
        </p>
        <h1 class="text-3xl leading-tight mt-4 max-w-[72ch] font-semibold">{t('home.headline')}</h1>
        <p class="text-fg-muted text-lg leading-body mt-6 max-w-[72ch]">{t('home.lead')}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/ruta/ruta-1"
            class="bg-primary text-primary-fg border-primary hover:bg-primary-hover rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
          >
            {t('home.startRoute')}
          </a>
          <a
            href="/simuladores/movil"
            class="bg-bg-raised text-fg border-border hover:border-fg-muted rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
          >
            {t('home.openSimulators')}
          </a>
        </div>
        <p class="text-fg-muted mt-5 text-sm">{t('home.tagline')}</p>
      </div>

      <aside class="bg-bg-raised border-border rounded-lg border p-6" aria-labelledby="ruta-titulo">
        <h2
          id="ruta-titulo"
          class="text-fg-muted m-0 font-mono text-xs font-normal tracking-[0.06em] uppercase"
        >
          {t('home.route.title')}
        </h2>
        <ol class="border-border mt-5 ml-2 list-none border-l-2 p-0">
          {modules.map(({ name, topics }) => (
            <li class="relative flex items-center justify-between py-2 pl-6">
              <span
                class="bg-primary absolute top-1/2 -left-[7px] h-3 w-3 -translate-y-1/2 rounded-full"
                aria-hidden="true"
              />
              <span>{name}</span>
              <span class="text-fg-muted font-mono text-xs">
                {t('home.route.topicCount', { topics })}
              </span>
            </li>
          ))}
          <li class="relative flex items-center gap-3 py-2 pl-6 font-semibold">
            <span
              class="bg-physical rounded-sm absolute top-1/2 -left-[7px] h-3 w-3 -translate-y-1/2"
              aria-hidden="true"
            ></span>
            <ChassisIcon />
            {t('home.route.robot')}
          </li>
        </ol>
      </aside>
    </div>

    <ul class="mt-9 grid list-none gap-5 p-0 md:grid-cols-3">
      {features.map(({ icon, title, text }) => (
        <li class="bg-bg-raised border-border rounded-lg border p-6">
          <span
            class="border-border rounded-md text-primary flex h-8 w-8 items-center justify-center border"
            aria-hidden="true"
          >
            {icon === 'circle' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" />
              </svg>
            )}
            {icon === 'square' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <rect
                  x="3"
                  y="3"
                  width="14"
                  height="14"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="2"
                />
              </svg>
            )}
            {icon === 'chassis' && <ChassisIcon />}
          </span>
          <h2 class="text-lg leading-tight mt-5 font-semibold">{title}</h2>
          <p class="text-fg-muted mt-3">{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-bg-raised border-border border-y">
    <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-7 px-5 py-10 md:px-8">
      <div class="max-w-[72ch]">
        <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
          {t('home.teachers.eyebrow')}
        </p>
        <h2 class="text-xl leading-tight mt-3 font-semibold">{t('home.teachers.title')}</h2>
        <p class="text-fg-muted mt-4">{t('home.teachers.text')}</p>
      </div>
      <a
        href="/docentes"
        class="bg-bg-raised text-fg border-border hover:border-fg-muted rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
      >
        {t('home.teachers.cta')}
      </a>
    </div>
  </section>
</Base>
