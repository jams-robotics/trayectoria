---
import { t } from '@trayectoria/i18n';

import { getCollection } from 'astro:content';

import ChassisIcon from '../components/ChassisIcon.astro';
import { AccountDeletedNotice } from '../components/auth/AccountDeletedNotice';
import { HomeDemo } from '../components/home/HomeDemo';
import Base from '../layouts/Base.astro';
import { homeModuleGroups } from '../lib/homeModules';

// The modules come from the `routes` collection, grouped by route (docs/ARCHITECTURE.md §3.5);
// each card links to the first published topic of its module (#539).
const routes = (await getCollection('routes')).map((entry) => ({ ...entry.data, id: entry.id }));
const publishedIds = new Set(
  (await getCollection('topics'))
    .filter((topic) => topic.data.status === 'published')
    .map((topic) => topic.id),
);
const groups = homeModuleGroups(routes, publishedIds);

// Idea of each module (§3.5): one literal key per module, so the i18n key check sees them all.
const IDEAS: Readonly<Record<string, string>> = {
  'ruta-1/m00': t('home.thread.ideas.ruta1.m00'),
  'ruta-1/m01': t('home.thread.ideas.ruta1.m01'),
  'ruta-1/m02': t('home.thread.ideas.ruta1.m02'),
  'ruta-1/m03': t('home.thread.ideas.ruta1.m03'),
  'ruta-2/m00': t('home.thread.ideas.ruta2.m00'),
  'ruta-2/m01': t('home.thread.ideas.ruta2.m01'),
  'ruta-2/m02': t('home.thread.ideas.ruta2.m02'),
};

/** The idea of a module; a module without one fails the build instead of showing a gap. */
function ideaOf(key: string): string {
  const idea = IDEAS[key];
  if (idea === undefined) throw new Error(`index.astro: falta home.thread.ideas para ${key}`);
  return idea;
}

/** Secondary call to action: a short topic, Rodadura (#648, decision 3). */
const TRY_TOPIC_HREF = '/ruta/ruta-1/m01/t04';

/** Issues labelled `contenido`: the findings of the reviews and their fixes (#648, decision 4). */
const CONTENT_ISSUES = 'https://github.com/jams-robotics/trayectoria/issues?q=is%3Aissue+label%3Acontenido';

const features = [
  {
    icon: 'circle',
    title: t('home.features.widgets.title'),
    text: t('home.features.widgets.text'),
  },
  {
    icon: 'chassis',
    title: t('home.features.simulators.title'),
    text: t('home.features.simulators.text'),
  },
  {
    icon: 'square',
    title: t('home.features.myRobot.title'),
    text: t('home.features.myRobot.text'),
  },
] as const;
---

<Base title={t('meta.siteName')} titleFull>
  <section class="mx-auto max-w-[1120px] px-5 pt-11 pb-9 md:px-8">
    <!-- Notice after deleting the account, `/?cuenta=eliminada` (F3-03). -->
    <AccountDeletedNotice client:load />
    <div class="grid items-start gap-9 lg:grid-cols-[1fr_500px] lg:gap-10">
      <div>
        <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
          {t('home.eyebrow')}
        </p>
        <h1 class="text-xl leading-tight mt-4 max-w-[72ch] font-semibold md:text-3xl">
          {t('home.headline')}
        </h1>
        <p class="text-fg-muted text-lg leading-body mt-6 max-w-[72ch]">{t('home.lead')}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/ruta/ruta-1"
            class="bg-primary text-primary-fg border-primary hover:bg-primary-hover rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
          >
            {t('home.startRoute')}
          </a>
          <a
            href={TRY_TOPIC_HREF}
            class="bg-bg-raised text-fg border-border hover:border-fg-muted rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
          >
            {t('home.tryTopic')}
          </a>
        </div>
        <p class="text-fg-muted mt-4 text-base">{t('home.tagline')}</p>
      </div>

      <!-- Hero: the line follower in demonstration mode, hydrated when the page is idle (#648). -->
      <HomeDemo client:idle />
    </div>

    <ul class="mt-9 grid list-none gap-5 p-0 md:grid-cols-3">
      {features.map(({ icon, title, text }) => (
        <li class="bg-bg-raised border-border rounded-lg border p-6">
          <span
            class="border-border rounded-md text-primary flex h-8 w-8 items-center justify-center border"
            aria-hidden="true"
          >
            {icon === 'circle' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" />
              </svg>
            )}
            {icon === 'square' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <rect
                  x="3"
                  y="3"
                  width="14"
                  height="14"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="2"
                />
              </svg>
            )}
            {icon === 'chassis' && <ChassisIcon />}
          </span>
          <h2 class="text-lg leading-tight mt-5 font-semibold">{title}</h2>
          <p class="text-fg-muted mt-3">{text}</p>
        </li>
      ))}
    </ul>

    <!-- Rigor strip (#582 point 7, wording of #648 decision 4). -->
    <p class="text-fg-muted mt-7 max-w-[72ch]">
      {t('home.rigor.text')}{' '}
      <a href={CONTENT_ISSUES} rel="noopener">{t('home.rigor.link')}</a>
    </p>
  </section>

  <section class="mx-auto max-w-[1120px] px-5 pb-10 md:px-8" aria-labelledby="hilo-titulo">
    <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
      {t('home.thread.eyebrow')}
    </p>
    <h2 id="hilo-titulo" class="text-xl leading-tight mt-3 font-semibold">
      {t('home.thread.title')}
    </h2>
    <p class="text-fg-muted leading-body mt-4 max-w-[72ch]">{t('home.thread.text')}</p>
    {groups.map(({ routeId, shortTitle, modules }) => (
      <section class="mt-7" aria-labelledby={`hilo-${routeId}`}>
        <h3 id={`hilo-${routeId}`} class="text-lg leading-tight m-0 font-semibold">
          {shortTitle}
        </h3>
        <ol class="mt-4 grid list-none gap-5 p-0 md:grid-cols-2 lg:grid-cols-3">
          {modules.map(({ key, number, title, topicCount, href }) => {
            const body = (
              <>
                <h4 class="text-base leading-tight m-0 font-semibold">
                  <span class="text-fg-muted mr-2 font-mono text-xs font-normal">
                    {t('home.thread.moduleLabel', { route: shortTitle, number })}
                  </span>
                  {title}
                </h4>
                <p class="text-fg-muted mt-3 mb-0">{ideaOf(key)}</p>
                <p class="text-fg-muted mt-3 mb-0 font-mono text-xs">
                  {t('home.route.topicCount', { topics: topicCount })}
                </p>
              </>
            );
            return (
              <li class="flex">
                {href === undefined ? (
                  <div class="bg-bg-raised border-border rounded-lg w-full border p-6">{body}</div>
                ) : (
                  <a
                    href={href}
                    class="bg-bg-raised border-border rounded-lg hover:border-primary text-fg block w-full border p-6 no-underline"
                  >
                    {body}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </section>

  <section class="bg-bg-raised border-border border-y">
    <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-7 px-5 py-10 md:px-8">
      <div class="max-w-[72ch]">
        <p class="text-fg-muted font-mono text-xs tracking-[0.06em] uppercase">
          {t('home.teachers.eyebrow')}
        </p>
        <h2 class="text-xl leading-tight mt-3 font-semibold">{t('home.teachers.title')}</h2>
        <p class="text-fg-muted mt-4">{t('home.teachers.text')}</p>
      </div>
      <a
        href="/docentes"
        class="bg-bg-raised text-fg border-border hover:border-fg-muted rounded-md inline-flex h-[44px] items-center border px-5 font-semibold no-underline"
      >
        {t('home.teachers.cta')}
      </a>
    </div>
  </section>
</Base>
