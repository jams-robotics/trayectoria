# Security headers of the public instance (#507). Workers Static Assets applies them to every
# response of apps/web/dist; infra/Caddyfile sends the same ones on self-hosted copies.
#
# __SUPABASE_ORIGINS__ is replaced when deploying (infra/csp-origins.sh, from deploy.yml) with the
# Supabase project the build talks to: its https origin and the wss one of Realtime.
#
# __SCRIPT_HASHES__ is replaced when deploying (scripts/csp-hashes.mjs, from deploy.yml, before
# csp-origins.sh) with the sha256 hash of every inline script of the build: the theme script of
# layouts/Base.astro, Astro's island runtime and its client:* directives, and the scripts of
# components/Nav.astro and components/tema/Outline.astro (inlined because they are small).
# script-src: https://static.cloudflareinsights.com is the Cloudflare Web Analytics beacon.
# style-src 'unsafe-inline': KaTeX writes style="" attributes into every formula and Astro inlines
# the island styles. font-src data:: KaTeX CSS embeds its smallest fonts as data: URLs.
# connect-src blob:: the arm simulator reads the meshes of an imported URDF zip from object URLs.
# https://cloudflareinsights.com receives the Web Analytics beacon.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__ https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self' data:; connect-src 'self' __SUPABASE_ORIGINS__ blob: https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
