<?xml version="1.0"?>
<!-- La malla de link1 no declara filename. -->
<robot name="malla sin filename">
  <link name="base_link"/>
  <link name="link1">
    <visual>
      <geometry>
        <mesh scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0"/>
  </joint>
</robot>
