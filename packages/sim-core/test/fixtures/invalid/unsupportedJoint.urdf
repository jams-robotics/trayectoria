<?xml version="1.0"?>
<!-- Los tipos floating y planar no se soportan en v1. -->
<robot name="joint no soportado">
  <link name="base_link"/>
  <link name="link1"/>
  <joint name="joint1" type="floating">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
