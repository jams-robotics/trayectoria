<?xml version="1.0"?>
<!-- joint1 apunta a un hijo "link_fantasma" que no está declarado como <link>. -->
<robot name="link ausente">
  <link name="base_link"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link_fantasma"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0"/>
  </joint>
</robot>
