{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dof": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reach_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "payload_kg": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_usd_approx": {
      "type": "number",
      "minimum": 0
    },
    "license": {
      "type": "object",
      "properties": {
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "software": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hardware",
        "software"
      ],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "plans": {
          "type": "string",
          "format": "uri"
        },
        "bom": {
          "type": "string",
          "format": "uri"
        },
        "buy": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "photo": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "dof",
    "reach_m",
    "payload_kg",
    "cost_usd_approx",
    "license",
    "links",
    "verifiedAt",
    "photo",
    "summary"
  ],
  "additionalProperties": false
}
