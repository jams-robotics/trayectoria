<?xml version="1.0"?>
<!-- Planar 2-DOF arm of docs/ROBOT-SPEC.md §4, written by hand with primitive geometry:
     l1 = 0.20 m, l2 = 0.15 m, two revolute joints about Z with limits [-pi, pi].
     No mesh files: every visual is a <cylinder> or a <box>. -->
<robot name="Brazo plano 2 GDL">

  <material name="base">
    <color rgba="0.29 0.33 0.39 1.0"/>
  </material>
  <material name="link">
    <color rgba="0.96 0.62 0.11 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.02"/>
      </geometry>
      <material name="base"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

  <!-- Upper arm, length l1 = 0.20 m along +X of its own frame. -->
  <link name="link1">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.2"/>
      </geometry>
      <material name="link"/>
    </visual>
    <collision>
      <origin xyz="0.1 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-05" ixy="0" ixz="0" iyy="0.00067" iyz="0" izz="0.00067"/>
    </inertial>
  </link>

  <!-- Forearm, length l2 = 0.15 m along +X of its own frame. -->
  <link name="link2">
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.15"/>
      </geometry>
      <material name="link"/>
    </visual>
    <collision>
      <origin xyz="0.075 0 0" rpy="0 1.5707963267948966 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.075 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="7.5e-06" ixy="0" ixz="0" iyy="0.00029" iyz="0" izz="0.00029"/>
    </inertial>
  </link>

  <!-- End effector frame at the tip of l2. -->
  <link name="tool0"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" velocity="2.0" effort="10.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" velocity="2.0" effort="10.0"/>
  </joint>

  <joint name="joint_tool" type="fixed">
    <parent link="link2"/>
    <child link="tool0"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
  </joint>

</robot>
