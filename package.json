{
  "name": "trayectoria",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma open source en español para aprender ingeniería aplicada a robótica",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @trayectoria/web dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r --if-present run sync && eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "e2e": "pnpm --filter @trayectoria/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
